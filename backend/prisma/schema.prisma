datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum UserRole {
  BUYER_RENTER
  OWNER_AGENT
  PROPERTY_MANAGER
  ADMIN
}

enum ListingPurpose {
  FOR_SALE
  FOR_RENT
}

enum PropertyType {
  HOUSE
  APARTMENT
  COMMERCIAL_PLOT
  RESIDENTIAL_PLOT
  OFFICE
  SHOP
  FARM_HOUSE
}

enum AreaUnit {
  MARLA
  KANAL
  SQ_FT
  SQ_YARD
}

enum ListingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum InquiryStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum RentPaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  PAY_ORDER
  OTHER
}

enum ExpenseCategory {
  MAINTENANCE
  UTILITY
  TAX_LEGAL
  MANAGEMENT_FEE
  INSURANCE
  RENOVATION
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

// -------------------------------------------------------------
// Core User & Auth Models
// -------------------------------------------------------------

model User {
  id               String          @id @default(uuid())
  email            String?         @unique
  phone            String          @unique // E.164 format, e.g. +923001234567
  passwordHash     String
  fullName         String
  role             UserRole        @default(BUYER_RENTER)
  agencyName       String?
  avatarUrl        String?
  isPhoneVerified  Boolean         @default(false)
  preferredLocale  String          @default("en") // "en" | "ur"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  listingsSubmitted Listing[]       @relation("OwnerListings")
  reviewedListings  Listing[]       @relation("AdminReviews")
  savedFavorites    SavedListing[]
  inquiriesSent     ListingInquiry[]
  viewingsRequested ViewingRequest[]
  managedProperties Property[]      @relation("PropertyManager")
  ownedProperties   Property[]      @relation("PropertyOwner")
  leasesAsTenant    Lease[]         @relation("TenantLeases")
  recordedPayments  ManualPaymentRecord[] @relation("RecordedByUser")
  loggedExpenses    Expense[]       @relation("ExpenseLoggedBy")
  reportedTickets   MaintenanceRequest[] @relation("ReportedByUser")
  auditLogs         AuditLog[]

  @@index([phone])
  @@index([role])
}

// -------------------------------------------------------------
// Marketplace Models
// -------------------------------------------------------------

model Listing {
  id              String         @id @default(uuid())
  ownerId         String
  reviewedById    String?
  title           String
  titleUrdu       String?
  description     String
  descriptionUrdu String?
  purpose         ListingPurpose
  propertyType    PropertyType
  pricePkr        Decimal        @db.Decimal(14, 2)
  isNegotiable    Boolean        @default(false)

  // Location specifications
  city            String         // Lahore, Karachi, Islamabad, etc.
  areaLocation    String         // e.g. DHA Phase 5, Bahria Town, Gulberg
  address         String?
  latitude        Decimal?       @db.Decimal(10, 7)
  longitude       Decimal?       @db.Decimal(10, 7)

  // Property features
  areaValue       Decimal        @db.Decimal(10, 2)
  areaUnit        AreaUnit       @default(MARLA)
  bedrooms        Int?
  bathrooms       Int?
  carSpaces       Int?
  isFeatured      Boolean        @default(false)
  isVerifiedBadge Boolean        @default(false)

  // Review & moderation workflow
  status          ListingStatus  @default(PENDING_APPROVAL)
  rejectionReason String?
  reviewedAt      DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  owner           User           @relation("OwnerListings", fields: [ownerId], references: [id])
  reviewedBy      User?          @relation("AdminReviews", fields: [reviewedById], references: [id])
  images          ListingImage[]
  savedByUsers    SavedListing[]
  inquiries       ListingInquiry[]
  viewingRequests ViewingRequest[]

  @@index([status, city, purpose, pricePkr])
  @@index([ownerId])
  @@index([city, areaLocation])
}

model ListingImage {
  id         String   @id @default(uuid())
  listingId  String
  storageKey String   // Cloud storage object key
  url        String   // Public CDN URL
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model SavedListing {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model ListingInquiry {
  id           String        @id @default(uuid())
  listingId    String
  userId       String
  contactName  String
  contactPhone String
  message      String
  status       InquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
}

model ViewingRequest {
  id            String        @id @default(uuid())
  listingId     String
  userId        String
  preferredDate DateTime
  preferredTime String
  contactPhone  String
  notes         String?
  status        InquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
}

// -------------------------------------------------------------
// Property Management & Unit Models
// -------------------------------------------------------------

model Property {
  id           String       @id @default(uuid())
  ownerId      String
  managerId    String?
  name         String
  propertyType PropertyType
  city         String
  areaLocation String
  address      String
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  owner        User         @relation("PropertyOwner", fields: [ownerId], references: [id])
  manager      User?        @relation("PropertyManager", fields: [managerId], references: [id])
  units        Unit[]
  expenses     Expense[]

  @@index([ownerId])
  @@index([managerId])
}

model Unit {
  id                  String               @id @default(uuid())
  propertyId          String
  unitNumber          String               // e.g. "Flat 302", "Ground Floor Villa"
  bedrooms            Int?
  bathrooms           Int?
  monthlyRentPkr      Decimal              @db.Decimal(14, 2)
  isOccupied          Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@index([propertyId])
}

model Lease {
  id                 String               @id @default(uuid())
  unitId             String
  tenantId           String
  startDate          DateTime
  endDate            DateTime
  monthlyRentPkr     Decimal              @db.Decimal(14, 2)
  securityDepositPkr Decimal              @db.Decimal(14, 2)
  status             LeaseStatus          @default(ACTIVE)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  unit               Unit                 @relation(fields: [unitId], references: [id])
  tenant             User                 @relation("TenantLeases", fields: [tenantId], references: [id])
  documents          LeaseDocument[]
  rentSchedules      RentSchedule[]
  manualPayments     ManualPaymentRecord[]

  @@index([unitId])
  @@index([tenantId])
}

model LeaseDocument {
  id           String   @id @default(uuid())
  leaseId      String
  documentType String   // "CNIC_FRONT", "CNIC_BACK", "TENANCY_AGREEMENT", "POLICE_VERIFICATION"
  storageKey   String   // Private cloud storage key
  filename     String
  mimeType     String
  createdAt    DateTime @default(now())

  lease        Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId])
}

model RentSchedule {
  id             String            @id @default(uuid())
  leaseId        String
  dueDate        DateTime
  amountDuePkr   Decimal           @db.Decimal(14, 2)
  amountPaidPkr  Decimal           @default(0.00) @db.Decimal(14, 2)
  status         RentPaymentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lease          Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  paymentRecords ManualPaymentRecord[]

  @@index([leaseId, dueDate])
}

model ManualPaymentRecord {
  id                String        @id @default(uuid())
  leaseId           String
  rentScheduleId    String?
  recordedByUserId  String
  amountPaidPkr     Decimal       @db.Decimal(14, 2)
  paymentDate       DateTime
  paymentMethod     PaymentMethod
  referenceNumber   String?       // e.g. Bank transaction ID, Cheque #
  bankName          String?       // e.g. Meezan Bank, HBL
  receiptStorageKey String?       // Private storage receipt slip image
  isVerified        Boolean       @default(false)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  lease             Lease         @relation(fields: [leaseId], references: [id])
  rentSchedule      RentSchedule? @relation(fields: [rentScheduleId], references: [id])
  recordedByUser    User          @relation("RecordedByUser", fields: [recordedByUserId], references: [id])

  @@index([leaseId])
  @@index([recordedByUserId])
}

model Expense {
  id                String          @id @default(uuid())
  propertyId        String
  loggedById        String
  category          ExpenseCategory
  amountPkr         Decimal         @db.Decimal(14, 2)
  expenseDate       DateTime
  title             String
  description       String?
  receiptStorageKey String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  property          Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  loggedBy          User            @relation("ExpenseLoggedBy", fields: [loggedById], references: [id])

  @@index([propertyId, expenseDate])
}

model MaintenanceRequest {
  id           String              @id @default(uuid())
  unitId       String
  reportedById String
  title        String
  description  String
  priority     MaintenancePriority @default(MEDIUM)
  status       MaintenanceStatus   @default(OPEN)
  resolvedAt   DateTime?
  costPkr      Decimal?            @db.Decimal(14, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  unit         Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  reportedBy   User                @relation("ReportedByUser", fields: [reportedById], references: [id])

  @@index([unitId, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   // e.g. "LISTING_APPROVED", "MANUAL_PAYMENT_LOGGED"
  entityType String   // "Listing", "ManualPaymentRecord", "Lease"
  entityId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}
