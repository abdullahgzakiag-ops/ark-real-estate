# Database connection string (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/ark_real_estate?schema=public"

# Node environment and server port
NODE_ENV="development"
PORT=5000

# Security tokens (replace with strong secret keys in production)
JWT_SECRET="ark_dev_secret_change_me_in_production"
JWT_REFRESH_SECRET="ark_dev_refresh_secret_change_me_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloud object storage placeholders (AWS S3 / Cloudflare R2 / Google Cloud Storage)
STORAGE_BUCKET_PUBLIC="ark-property-photos-dev"
STORAGE_BUCKET_PRIVATE="ark-private-documents-dev"
STORAGE_REGION="ap-southeast-1"
STORAGE_ACCESS_KEY_ID="replace_with_storage_access_key"
STORAGE_SECRET_ACCESS_KEY="replace_with_storage_secret_key"
